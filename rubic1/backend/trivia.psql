-- -----------------------------------------------------------------------
-- Reset sequences so the next INSERT auto-increments correctly
-- -----------------------------------------------------------------------
SELECT setval('categories_id_seq', (SELECT MAX(id) FROM categories));
SELECT setval('questions_id_seq',  (SELECT MAX(id) FROM questions));
